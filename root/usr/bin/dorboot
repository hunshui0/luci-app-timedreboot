#!/bin/bash

# [K] (C)2020
# http://github.com/kongfl888/luci-app-timedreboot

sleep 5s

if [ ! -e "/etc/config/timedreboot" ]; then
    echo "timedreboot cfg is not exit" >> /tmp/timedreboot.log
    logger "timedreboot cfg is not exit. Stop!"
    exit 1
fi

renable=1

# --------function--------

get_cfg_value(){

    v=`uci get timedreboot.@main[0].$1 2>/dev/null`

    if [ ! -z "$v" ]; then
        echo "$v"
    else
        echo "1"
    fi
}

update_cron() {
    local entries=""
    if [ -f /etc/crontabs/root ]; then
        entries=$(awk '$1 ~ /^#/ || $6 != "/usr/bin/dorboot"' /etc/crontabs/root) || return 1
    fi
    {
        if [ -n "$entries" ]; then
            printf '%s\n' "$entries"
        fi
        if [ "$#" -eq 2 ]; then
            printf '%s /usr/bin/dorboot %s\n' "$1" "$2"
        fi
    } | crontab -c /etc/crontabs -
}

rebootsys() {
    if [ "${1}" = "1" ]; then
        uci set timedreboot.@main[0].enable="0"
        uci set timedreboot.@main[0].once="0"
        uci commit timedreboot
        update_cron || return 1
    fi
    sleep 5s
    touch /etc/banner
    sleep 5s
    reboot
}

justcfg() {
    local cronstr
    cronstr=$(awk '$1 !~ /^#/ && $6 == "/usr/bin/dorboot" { print $1, $2, $3, $4, $5, $7 }' /etc/crontabs/root 2>/dev/null)
    renable=$(get_cfg_value "enable")
    if [ "$renable" = "0" ]; then
        if [ -n "$cronstr" ]; then
            update_cron || return 1
        fi
        echo "Timed Reboot has been cleared." > /tmp/timedreboot.log
        return
    fi

    local minute=`get_cfg_value "minute"`
    local hour=`get_cfg_value "hour"`
    local week=`get_cfg_value "week"`
    local sday="*"
    local once=`get_cfg_value "once"`

    if [ "$minute" = "0" ]; then
        minute="00"
    fi

    case "$week" in
        7)
            week="*"
            ;;
        8)
            sday=$(get_cfg_value "sday" | grep -owE '^[0-9]+-[0-9]+|^[0-9]+(,[0-9]+)*')
            sday=${sday:-15}
            week="*"
            ;;
        *)
            if [[ ! $week =~ ^[0-6](\ [0-6])*$ ]]; then
                logger "Timed Reboot: invalid weekday setting."
                return 1
            fi
            week=${week// /,}
            ;;
    esac

    local cfgstr="$minute $hour $sday * $week"

    if [ "$cfgstr $once" != "$cronstr" ]; then
        update_cron "$cfgstr" "$once" || return 1
    fi
    if ! /etc/init.d/cron running; then
        /etc/init.d/cron start || return 1
    fi
    echo "Timed Reboot is set." > /tmp/timedreboot.log
}

# ------------main-------------

renable=`get_cfg_value "enable"`
if [ "$renable" != "0" ]; then
        /etc/init.d/timedreboot enable
fi

if [ "${1}" = "0" -o "${1}" = "1" ]; then
    rebootsys "$1"
else
    justcfg
fi

exit $?
